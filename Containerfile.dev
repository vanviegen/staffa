# Dev container image for Staffa: Node for building the library and serving its
# demo. The tests run in ShoTest's pinned Playwright image, so that screenshots
# render like the accepted baselines in test-accepted/.

FROM docker.io/library/node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git sudo bash procps psmisc ripgrep less nano \
      openssh-client unzip zip xz-utils build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
# The docker CLI, talking to the socket TPS serves at $DOCKER_HOST: with it,
# `shotest test` runs in the pinned Playwright image.
RUN curl -fsSL https://download.docker.com/linux/static/stable/$(uname -m)/docker-29.9.1.tgz \
      | tar xz -C /usr/local/bin --strip-components=1 docker/docker
# node's image already has a uid 1000 user named 'node', who owns its home.
RUN echo 'node ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/node
USER node
WORKDIR /work

# 'app' (the CMD) builds and serves the demo statically: `-P` is the SPA fallback
# the demo's routed URLs need, `-c-1` turns off http-server's hour of caching (the
# demo loads /dist as ES modules, so a cached one hides every rebuild behind it),
# and the build comes first so a fresh container serves the current source rather
# than whatever dist/ happens to hold. 3847 is ShoTest's review app.
EXPOSE 8080 3847
CMD ["sh", "-c", "npm install && npm run build && npx http-server -p 8080 -a 0.0.0.0 -c-1 -P 'http://localhost:8080/demo/index.html?'"]

# Passes once the tests do (they load the demo from dist/) and the user has
# accepted every visual change, telling the user where to find the review app
# for as long as it runs.
LABEL tps.test="npm install && npm run build && npx shotest test && /tps/guest-tool show-user-text 'Visual changes await your review in the **3847** tab: accept them or comment on them, then press **Apply**.' && trap '/tps/guest-tool show-user-text' EXIT && npx shotest review"
# Pushing is the release: GitHub Actions publishes to npm what is pushed.
LABEL tps.deploy="git push origin HEAD:main"
# ShoTest's result cache, shared by all tasks and the test that merging runs:
# no test runs twice on the same source tree, which the commit message TPS
# asks for is no part of.
ENV SHOTEST_CACHE_DIR=/home/node/.shotest-cache SHOTEST_IGNORE=.tps-commit-message
LABEL tps.cache="/home/node/.npm /home/node/.shotest-cache"
